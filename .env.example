# Copy this file to .env and fill in your key. .env is git-ignored. Never commit a real key.
GEMINI_API_KEY=your-key-here

# Model used by the judge. Check Google AI Studio for the models and limits your free tier includes.
GUARD_LLM_MODEL=gemini-3.5-flash

# Free-tier friendly limits
GUARD_LLM_RPM=10
GUARD_LLM_TIMEOUT_S=8

# When to call the judge, and how much to trust it
GUARD_LLM_LOW=0.3
GUARD_LLM_MIN_CONF=0.6
GUARD_LLM_REVIEW_BLOCKS=false
GUARD_LLM_FAIL_OPEN=true

# Set to false to switch the LLM layer off even when a key is present
GUARD_LLM_ENABLED=true
